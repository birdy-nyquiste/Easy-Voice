# --- App ---
APP_URL=http://localhost:3000
DATABASE_URL=postgres://localhost:5432/easy_voice
# 32+ random chars; used to hash OTP codes
AUTH_SECRET=change-me-to-a-long-random-string
# Shared secret for /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me
# Encrypts API keys users connect (ElevenLabs). Any long random string; changing it forces users to reconnect.
SECRETS_KEY=change-me-to-another-long-random-string

# --- Google OAuth (optional in dev) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional; OTP codes are logged to the console when unset) ---
RESEND_API_KEY=
EMAIL_FROM="Easy Voice <login@example.com>"

# --- Stripe (required for top-ups; use test-mode keys in dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Telnyx ---
# "mock" (default) or "live"
TELNYX_MODE=mock
TELNYX_API_KEY=
# Base64 ed25519 public key from the Telnyx portal (webhook signing)
TELNYX_PUBLIC_KEY=
# Call Control Application id; numbers are attached to it and outbound calls dial through it
TELNYX_CONNECTION_ID=
# Platform-fixed models. Leave empty to use the pinned defaults below.
# Changing these re-syncs existing agents (daily cron, or when a user opens Agents).
# Note: deepgram/nova-3 + "auto" does not recognise Mandarin; use AssemblyAI for EN/ZH.
TELNYX_LLM_MODEL=moonshotai/Kimi-K2.6
TELNYX_STT_MODEL=assemblyai/universal-3-5-pro
TELNYX_STT_LANGUAGE=auto
TELNYX_CLONE_MODEL=Qwen3TTS
# Voice cloning: on|off. Defaults to off in live mode (the Telnyx account needs L2 verification
# before cloned voices can be used), on in mock mode.
# VOICE_CLONING=on
# Insight group containing a call-summary insight (optional)
TELNYX_INSIGHT_GROUP_ID=
# Messaging profile for receiving texts (receive only; nothing is ever sent). Its webhook URL must be
# https://<host>/api/webhooks/telnyx (API v2). Leave empty to turn texting off in live mode.
TELNYX_MESSAGING_PROFILE_ID=

# --- ElevenLabs (users bring their own key; see docs/elevenlabs-notes.md) ---
# on|off. Defaults to on, except in live mode without SECRETS_KEY.
# ELEVENLABS=on
# "mock" or "live"; follows TELNYX_MODE when unset.
# ELEVENLABS_MODE=
# TTS model for ElevenLabs voices on calls.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# --- Pricing (US cents) ---
PRICE_CALL_PER_MINUTE_CENTS=15
PRICE_NUMBER_MONTHLY_CENTS=300
PRICE_VOICE_CLONE_CENTS=500
PRICE_SMS_INBOUND_PER_PART_CENTS=2
MIN_TOPUP_CENTS=1000
NEGATIVE_BALANCE_RELEASE_DAYS=7
RETENTION_DAYS=30

# Per-agent knowledge bases (SPEC §18). Off by default in live mode; URL sources need their own switch
# because a Telnyx crawl can't be limited.
# KNOWLEDGE_BASE=on
# KNOWLEDGE_BASE_URLS=off
# PRICE_KNOWLEDGE_SOURCE_CENTS=100
